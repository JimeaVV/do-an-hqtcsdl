# Sao chép file này thành .env và chỉnh sửa cho phù hợp với máy của bạn.
# Không commit file .env thực tế lên repo (đã có trong .gitignore).

# Tên driver ODBC (mặc định dùng ODBC Driver 18 for SQL Server)
# Kiểm tra driver đã cài: ODBC Data Sources (64-bit) trên Windows
DB_DRIVER=ODBC Driver 18 for SQL Server

# Địa chỉ SQL Server:
#   - Nếu dùng SQL Server Express (mặc định): localhost\SQLEXPRESS
#   - Nếu dùng SQL Server Developer/Standard (instance mặc định): localhost
DB_SERVER=localhost\SQLEXPRESS

# Tên database
DB_NAME=ShopDB

# Xác thực Windows (yes = dùng tài khoản Windows hiện tại, không cần user/password)
DB_TRUSTED_CONNECTION=yes

# Bỏ qua lỗi certificate SSL (nên để yes khi dùng local)
DB_TRUST_SERVER_CERTIFICATE=yes
